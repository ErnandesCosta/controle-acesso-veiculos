POSTGRES_DB=controle_acesso
POSTGRES_USER=controle_acesso_app
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Use um segredo aleatório com pelo menos 32 caracteres. Nunca versione o valor real.
JWT_SIGNING_KEY=change_this_local_jwt_signing_key_32_chars

# Execute ./New-DataProtectionCertificate.ps1 e mantenha o PFX em secrets/.
# A senha real deve ter ao menos 16 caracteres e permanecer no arquivo ignorado.
DATA_PROTECTION_CERTIFICATE_FILE=./secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD_FILE=./secrets/data-protection-password.txt

API_PORT=8080
FRONTEND_PORT=3000

# OpenTelemetry permanece desabilitado até existir um collector acessível.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=controle-acesso-veiculos-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
